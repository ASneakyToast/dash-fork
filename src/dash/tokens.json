{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "light": {
    "dash": {
      "color": {
        "bg": {
          "$type": "color",
          "$value": "#fafaf9",
          "$description": "The page background.",
          "$extensions": {
            "dev.dash": {
              "legacy": "--bg"
            }
          }
        },
        "surface": {
          "$type": "color",
          "$value": "#ffffff",
          "$description": "Panels, the sidebar, inputs and assistant messages.",
          "$extensions": {
            "dev.dash": {
              "legacy": "--panel"
            }
          }
        },
        "text": {
          "$type": "color",
          "$value": "#1c1917",
          "$description": "Body text.",
          "$extensions": {
            "dev.dash": {
              "legacy": "--text"
            }
          }
        },
        "text-muted": {
          "$type": "color",
          "$value": "#78716c",
          "$description": "Secondary text, hints and metadata.",
          "$extensions": {
            "dev.dash": {
              "legacy": "--muted"
            }
          }
        },
        "border": {
          "$type": "color",
          "$value": "#e7e5e4",
          "$description": "Dividers and control borders.",
          "$extensions": {
            "dev.dash": {
              "legacy": "--line"
            }
          }
        },
        "accent": {
          "$type": "color",
          "$value": "#2563eb",
          "$description": "The active tab, focus and hover emphasis.",
          "$extensions": {
            "dev.dash": {
              "legacy": "--accent"
            }
          }
        },
        "on-accent": {
          "$type": "color",
          "$value": "#ffffff",
          "$description": "Text on an accent background."
        },
        "bubble-user": {
          "$type": "color",
          "$value": "#eff6ff",
          "$description": "The background of the user's own messages.",
          "$extensions": {
            "dev.dash": {
              "legacy": "--user"
            }
          }
        },
        "danger": {
          "$type": "color",
          "$value": "#dc2626",
          "$description": "Errors."
        }
      },
      "radius": {
        "control": {
          "$type": "dimension",
          "$value": "6px",
          "$description": "Buttons and inputs."
        },
        "bubble": {
          "$type": "dimension",
          "$value": "10px",
          "$description": "Message bubbles."
        }
      },
      "font": {
        "family": {
          "$type": "fontFamily",
          "$value": "system-ui, sans-serif",
          "$description": "The body font stack."
        },
        "size": {
          "$type": "dimension",
          "$value": "15px",
          "$description": "The base font size."
        }
      }
    }
  },
  "dark": {
    "dash": {
      "color": {
        "bg": {
          "$type": "color",
          "$value": "#0c0a09"
        },
        "surface": {
          "$type": "color",
          "$value": "#1c1917"
        },
        "text": {
          "$type": "color",
          "$value": "#f5f5f4"
        },
        "text-muted": {
          "$type": "color",
          "$value": "#a8a29e"
        },
        "border": {
          "$type": "color",
          "$value": "#292524"
        },
        "accent": {
          "$type": "color",
          "$value": "#60a5fa"
        },
        "on-accent": {
          "$type": "color",
          "$value": "#0c0a09"
        },
        "bubble-user": {
          "$type": "color",
          "$value": "#172554"
        },
        "danger": {
          "$type": "color",
          "$value": "#f87171"
        }
      }
    }
  }
}
